{
  "name": "shadow-ops",
  "private": true,
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"wait-on tcp:5173 && electron electron/main.cjs\"",
    "desktop:dist": "npm run build:native && electron-builder",
    "desktop:dist:win": "npm run build:native && electron-builder --win",
    "desktop:dist:mac": "npm run build:native && electron-builder --mac",
    "mobile:sync": "npm run build:native && npx cap sync",
    "mobile:add:android": "npx cap add android",
    "mobile:add:ios": "npx cap add ios",
    "mobile:open:android": "npx cap open android",
    "mobile:open:ios": "npx cap open ios",
    "mobile:run:android": "npm run mobile:sync && npx cap run android",
    "mobile:run:ios": "npm run mobile:sync && npx cap run ios",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview --host 0.0.0.0",
    "lan:server": "node server/lan-server.js",
    "lan:host": "node scripts/lan-host.js",
    "test": "vitest",
    "test:run": "vitest run --coverage",
    "build:native": "vite build --mode native"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@radix-ui/react-toast": "^1.2.2",
    "@tanstack/react-query": "^5.84.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.16.4",
    "lucide-react": "^0.475.0",
    "pathfinding": "^0.4.18",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.18.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.shadowops.game",
    "productName": "Shadow Ops",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "server/**/*",
      "src/lib/game/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.8.32",
    "concurrently": "^9.2.0",
    "electron": "^32.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.14.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.1.0",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "description": "Shadow Ops — A cooperative multiplayer stealth game with unique player abilities, tactical missions, and mobile controllers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Advaith-1506/shadow-ops.git"
  },
  "homepage": "https://github.com/Advaith-1506/shadow-ops#readme",
  "bugs": {
    "url": "https://github.com/Advaith-1506/shadow-ops/issues"
  },
  "keywords": [
    "shadow-ops",
    "cooperative",
    "stealth",
    "multiplayer",
    "theta-tau",
    "mobile-controller"
  ]
}
